  {
   "cell_type": "markdown",
   "source": "## 8. Test Set Evaluation",
   "metadata": {
    "_uuid": "b44e047e-6918-43d9-9e41-cfedc9d1e11d",
    "_cell_guid": "a5a3f3a2-4f06-4f00-b3f4-2f5be4bfdbbc",
    "trusted": true,
    "collapsed": false,
    "id": "yMdN_EvkUcI8",
    "jupyter": {
     "outputs_hidden": false
    }
   }
  },
  {
   "cell_type": "code",
   "source": "print('\\nFinal Test Results')\nprint('='*60)\n\n_, wiki_test_map_poa, wiki_test_mrr_poa = evaluate(wiki_model_poa, wiki_test_loader)\n_, wiki_test_map_base, wiki_test_mrr_base = evaluate(wiki_model_base, wiki_test_loader)\n\nprint(f'{\"Model\":<25} {\"MAP\":>8} {\"MRR\":>8}')\nprint('-'*43)\nprint(f'{\"Attention-BLSTM (base)\":<25} {wiki_test_map_base:>8.4f} {wiki_test_mrr_base:>8.4f}')\nprint(f'{\"RNN-POA (ours)\":<25} {wiki_test_map_poa:>8.4f} {wiki_test_mrr_poa:>8.4f}')\n\nif wiki_test_map_base > 0:\n    improvement = (wiki_test_map_poa - wiki_test_map_base) / wiki_test_map_base * 100\n    print(f'\\nMAP improvement: {improvement:+.2f}%')",
   "metadata": {
    "_uuid": "810a5c21-d082-4b17-a85e-29d9516777a6",
    "_cell_guid": "364c4966-5746-4247-bb7a-2b69e4278ba3",
    "trusted": true,
    "collapsed": false,
